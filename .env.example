# Copy to .env and fill in. .env is gitignored.

# Etherscan V2 unified API key - ONE key works across BSC, Ethereum, Polygon, etc.
# Get a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Default AI reviewer: claude | codex | openai | none
CHAINSENTINEL_AI=claude

# Only needed if you use --ai openai (or an OpenAI-compatible endpoint).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional per-chain RPC overrides (use your own node / a paid RPC for reliability).
# CHAINSENTINEL_RPC_BSC=https://bsc-dataseed.bnbchain.org
# CHAINSENTINEL_RPC_ETHEREUM=https://eth.llamarpc.com
